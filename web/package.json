{
  "name": "code-diagram",
  "version": "1.0.0",
  "description": "Code structure visualizer (Python, HTML, CSS, JS)",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.21.0 <23"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:contract": "jest test/contract",
    "test:integration": "jest test/integration",
    "test:coverage": "jest --coverage",
    "test:live": "jest -c jest.live.config.js",
    "benchmark": "node test/benchmark.js",
    "vendor": "node scripts/vendor.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "audit": "npm audit --omit=dev --audit-level=high",
    "scan:secrets": "node scripts/scan.js secrets",
    "scan:image": "node scripts/scan.js image",
    "scan:staged": "node scripts/scan.js staged",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run audit && npm run test:coverage",
    "docker:build": "docker build --target prod -t code-diagram:local .",
    "docker:test": "docker build --target test -t code-diagram:test . && docker run --rm code-diagram:test",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env code-diagram:local",
    "prepare": "node -e \"import('husky').then((h) => { process.chdir('..'); console.log(h.default()); }, () => {})\""
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,html,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "simple-git": "^4.0.2",
    "tree-sitter": "^0.22.4",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.23.2",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@highlightjs/cdn-assets": "11.9.0",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "cose-base": "2.2.0",
    "cytoscape": "3.30.4",
    "cytoscape-dagre": "2.5.0",
    "cytoscape-fcose": "2.2.0",
    "d3-dispatch": "3.0.1",
    "d3-force": "3.0.0",
    "d3-quadtree": "3.0.1",
    "d3-timer": "3.0.1",
    "dagre": "0.8.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "layout-base": "2.0.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "typescript": "7.0.2"
  }
}
