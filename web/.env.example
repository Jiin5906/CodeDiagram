# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 Git에 올리지 않는다.

# 개발·테스트용 예비 Anthropic API 키. 로그인하지 않았거나 더미 로그인일 때 AI 해설·리팩토링에 쓴다.
# NODE_ENV=production이면 쓰지 않는다 (운영에서는 사용자가 자기 키로 로그인해야 한다).
ANTHROPIC_API_KEY=

# 더미 로그인: 개발 환경에서는 아무 값이나 넣어도 로그인된다 (AI는 위 예비 키로 동작).
# false로 두면 끈다. 운영(NODE_ENV=production)에서는 이 값과 상관없이 항상 꺼진다.
AUTH_DUMMY_LOGIN=

# AI 리팩토링에 쓸 모델 (비워 두면 claude-haiku-5-5)
ANTHROPIC_REFACTOR_MODEL=

# 서버 포트 (기본 3000)
PORT=3000

# 서버가 받을 주소 (기본 127.0.0.1: 이 PC에서만 접속). LAN에 열려면 0.0.0.0
HOST=127.0.0.1

# 추가로 허용할 Host 헤더 (쉼표 구분). localhost, 127.0.0.1, [::1], 10.0.2.2는 기본 허용
ALLOWED_HOSTS=

# 로컬 경로 분석을 허용할 루트 (쉼표 구분). 예: C:\Users\User\AndroidStudioProjects
# 설정하면 이 루트 안쪽 경로만 분석할 수 있다.
# 비워 두면 개발 환경에서는 모든 로컬 경로를 허용하고, 운영(NODE_ENV=production)에서는 로컬 경로를 막고 Git URL만 받는다.
LOCAL_ROOTS=

# clone을 허용할 Git 호스트 추가 (쉼표 구분). github.com, gitlab.com, bitbucket.org는 기본 허용.
# 기본 포트(443)가 아니면 git.example.com:8443처럼 포트까지 적는다. https URL만 지원하며 비공개 레포는 clone하지 않는다.
GIT_HOSTS=

# ---- 자원 사용 제한 (비워 두면 괄호 안 기본값) ----
# AI 호출 횟수 (1분당). 자기 키로 로그인한 세션 기준(60) / 예비 키를 쓰는 IP 기준(20). 캐시 적중은 세지 않는다.
AI_RATE_LIMIT_SESSION_PER_MIN=
AI_RATE_LIMIT_FALLBACK_PER_MIN=
# AI 해설에 보낼 함수 코드 최대 길이 (20000자)
EXPLAIN_MAX_CODE_CHARS=
# AI 결과 캐시 최대 개수 (500). 넘으면 가장 오래 쓰지 않은 것부터 지운다.
CACHE_MAX_ENTRIES=
# 동시 분석 수(2), 대기열 길이(4), 대기열에서 기다리는 최대 시간(30000ms). 넘치면 503.
MAX_CONCURRENT_ANALYSES=
MAX_QUEUED_ANALYSES=
ANALYSIS_QUEUE_WAIT_MS=
# git clone 전체 시간 상한(180초). 넘으면 504.
CLONE_TIMEOUT_SEC=
# clone 폴더 위치(web/repos)와 남겨 둘 개수(30). 넘으면 오래 쓰지 않은 것부터 지운다(분석 중·등록된 폴더 제외).
REPOS_DIR=
MAX_REPOS=

# ---- 보안 헤더 ----
# 다른 화면에 iframe으로 넣는 것을 허용할 출처 (쉼표 구분, 예: https://docs.example.com). 비우면 전부 차단.
FRAME_ANCESTORS=
# true면 CSP 위반을 차단하지 않고 서버 콘솔에 보고만 한다 (CDN·라이브러리를 바꿀 때 확인용)
CSP_REPORT_ONLY=
